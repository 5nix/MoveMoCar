{
  "ownerPhone": "13000000000",
  "notification": {
    "transport": "http",
    "url": "https://wxpusher.zjiecode.com/api/send/message/simple-push",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "bodyTemplate": {
      "summary": "{{vehicleTitle}}",
      "content": "<p>来自：{{phoneHtml}}</p><p>留言：{{messageHtml}}</p><p><a href=\"tel:{{phone}}\">点击回拨</a></p>",
      "contentType": 2,
      "spt": "YOUR_WXPUSHER_SPT",
      "url": "tel:{{phone}}"
    },
    "timeoutMs": 8000,
    "successStatus": [200, 299]
  }
}
