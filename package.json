    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@fontsource/cabin": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.0",
    "cborg": "^6.1.2",
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4",
    "simple-icons": "^15.22.0"
  }
}
