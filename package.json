{
  "name": "movemocar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A practical static parking contact QR code for everyday use.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
